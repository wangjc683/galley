+    except FileNotFoundError:
+        pass
+    except Exception as e:
+        print(f"[Discord] failed to purge media dir: {e}")
+
+
+def _cleanup_turn_dir(turn_dir):
+    if not turn_dir:
+        return
+    shutil.rmtree(turn_dir, ignore_errors=True)
+
