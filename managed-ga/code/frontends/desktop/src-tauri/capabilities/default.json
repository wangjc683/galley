{
  "identifier": "default",
  "description": "Least-privilege capabilities for the main application window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-start-bridge",
    "allow-retry-bootstrap",
    "allow-get-bootstrap-snapshot",
    "allow-export-mykey",
    "allow-pick-directory",
    "allow-pick-data-backup-file",
    "allow-pick-data-export-path",
    "allow-reveal-in-file-manager",
    "allow-get-ga-source",
    "allow-validate-ga-source",
    "allow-set-ga-source",
    "allow-clear-ga-source",
    "allow-get-macos-titlebar-metrics",
    "allow-shortcut-should-ask",
    "allow-shortcut-decide",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
