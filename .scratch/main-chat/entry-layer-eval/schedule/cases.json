  {
   "id": "report-wed",
   "no": 1,
   "group": "该建",
   "expect_text": "提到带时间的事（没说「提醒我」）→ 自己建一个叫醒自己的一次性提醒（--target=assistant），时间在周三下午之前；回复一句话说出时间",
   "history": [],
   "tasks": [],
   "message": "周三下午要交报告",
   "expect": {
    "create": "one",
    "window": {
     "from": {
      "now": true
     },
     "to": {
      "next_weekday": 3,
      "time": "18:00"
     }
    },
    "words_any": [
     "报告"
    ],
    "mentions_time": true,
    "max_chars": 150
   }
  },
