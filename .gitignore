# Tauri / GUI build artifacts
gui/dist/
# Repo-root target/ can appear if cargo is run from the repo root instead of
# core/; ignore it so stray build output (e.g. orphan tauri-sidecars placeholders)
# never shows up as untracked noise. Per-workspace target/ dirs below are also
# covered explicitly.
/target/
core/target/
core/gen/
core/tauri.updater.generated.conf.json
cli/target/
# Bundled Python distributions (regenerated by scripts/bundle-python.sh,
# ~80MB per arch — never committed).
core/python-bundle/
# Local cache directory. Regenerated downloads and command scratch output do not
# belong in the repo.
.cache/

# Local
.env
.env.local
*.log

# Main chat entry-layer eval: raw per-run transcripts stay on the machine
# that ran the suite (run.py --render-only rebuilds results.md from them);
# the tracked results.md summaries are the evidence.
.scratch/main-chat/entry-layer-eval/**/results.json
.scratch/main-chat/entry-layer-eval/dispatch-results.json

# Design handoff bundle: keep prototype, drop the uploads/ duplicates
# (those are AGENTS.md / PRD.md / DESIGN.md copies the design agent
# received as input; the canonical files live elsewhere in docs/).
docs/design-handoff/project/uploads/
